# Supabase — obtidos no dashboard do projecto (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de service role — SÓ no servidor (Server Actions / Edge Functions). Nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Resend — emails transaccionais (Fase 5). Free tier.
RESEND_API_KEY=re_xxxxxxxx

# URL base da app (para links em emails/convites)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só para `npm run seed:users` (contas falsas @trocata.test). Não uses uma palavra-passe tua.
SEED_USER_PASSWORD=
